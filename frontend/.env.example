# Populate VITE_* from `make tf-output ENV=dev` after first deploy.
# These bake into the SPA build — no runtime secret material here.

VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=secret-share-admin-dev.auth.us-east-1.amazoncognito.com
VITE_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_LOGOUT_URI=http://localhost:3000/

# Only needed locally — vite dev proxies /api → this URL so the SPA can call the
# dev API Gateway directly. In prod, CloudFront handles the /api/* routing.
VITE_DEV_API_PROXY=https://your-dev-api-id.execute-api.us-east-1.amazonaws.com
